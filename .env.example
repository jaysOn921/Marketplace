# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4000
# Public URL of the web app (used in emails and CORS in dev)
APP_URL=http://localhost:5173

# MySQL connection (see scripts/setup-local-mysql.sh or docker-compose.dev.yml)
DATABASE_URL=mysql://tzed:tzed_dev_password@127.0.0.1:3306/tzed
TEST_DATABASE_URL=mysql://tzed:tzed_dev_password@127.0.0.1:3306/tzed_test

# Session cookie signing secret (use a long random string in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
