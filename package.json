{
  "name": "tzed",
  "private": true,
  "description": "TZed — cross-border marketplace for Tanzania and Zambia",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @tzed/api & npm run dev --workspace @tzed/web & wait",
    "dev:api": "npm run dev --workspace @tzed/api",
    "dev:web": "npm run dev --workspace @tzed/web",
    "build": "npm run build --workspace @tzed/web && npm run build --workspace @tzed/api",
    "start": "npm run start --workspace @tzed/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "playwright-core": "1.56",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
