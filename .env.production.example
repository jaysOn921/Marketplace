# Production settings for docker-compose.yml. Copy to .env on the server and fill in.
# Never commit .env. Generate secrets with: openssl rand -base64 48

# Public domain (DNS A/AAAA record pointing at this server) and the full URL.
DOMAIN=tzed.example.com
APP_URL=https://tzed.example.com

# Database passwords (used by MySQL on first start, and by the app).
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Session cookie signing secret: at least 32 random characters.
SESSION_SECRET=

# Outgoing email (required in production), e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=TZed <no-reply@tzed.example.com>

LOG_LEVEL=info

# First admin account, created by: docker compose run --rm app node dist/seed.js
# Remove the password from this file once the admin has signed in and changed it.
SEED_ADMIN_EMAIL=admin@tzed.example.com
SEED_ADMIN_PASSWORD=

# Backups (scripts/backup-db.sh): how many of each kind to keep in backups/.
BACKUP_KEEP=14
